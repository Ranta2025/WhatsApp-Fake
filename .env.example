# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gorm
POSTGRES_PASSWORD=gorm
POSTGRES_DB=gorm

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT SECURITY
# ==========================================
# Genera una clave secreta fuerte y única
# Ejemplo: openssl rand -base64 32
SECRETKEY=your_super_secret_key_here_change_this

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Para recuperación de contraseñas
# Usa App Password si tienes 2FA en Gmail
GMAIL_FROM=your-email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# Alternativa por API HTTP (Brevo, gratis 300 emails/día). Si BREVO_API_KEY
# está definida se usa en lugar de SMTP. EMAIL_FROM debe estar verificado en Brevo.
BREVO_API_KEY=
EMAIL_FROM=

# ==========================================
# NGROK CONFIGURATION (OPCIONAL)
# ==========================================
# Para compartir tu app con amigos
# Obtén tu token en: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_token_here

# ==========================================
# GITHUB BUG REPORTS (OPCIONAL)
# ==========================================
# Para que usuarios reporten bugs automáticamente
# Obtén tu token en: https://github.com/settings/tokens
# Permisos necesarios: 'repo' o 'public_repo'
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repository-name

# ==========================================
# MINIO (ARCHIVOS/MEDIA)
# ==========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==========================================
# APP ENV
# ==========================================
ENV=development

# Orígenes extra permitidos por CORS/WebSocket (separados por comas).
# Útil para el dominio de producción, p. ej. https://chat.midominio.com
CORS_ALLOWED_ORIGINS=

# Dirección de escucha del backend (por defecto 0.0.0.0:8080)
SERVER_ADDR=0.0.0.0:8080

# Proxies de confianza para X-Forwarded-For (CIDRs separados por comas).
# Por defecto: loopback y redes privadas (nginx / Docker).
TRUSTED_PROXIES=

# Pool de conexiones de PostgreSQL (opcional)
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_SSLMODE=disable

# Servicios gestionados (tienen prioridad sobre las variables sueltas):
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require   (Neon, Render, Supabase)
# REDIS_URL=rediss://default:pass@host:6379                     (Upstash, Render Key Value)

# Cabecera con la IP real del cliente puesta por la plataforma de delante
# (p. ej. X-Real-IP detrás de las rewrites de Vercel). Vacío = X-Forwarded-For.
CLIENT_IP_HEADER=

# Almacenamiento S3 gestionado (Cloudflare R2):
# MINIO_REGION=auto
# MINIO_MANAGE_BUCKET=false
# MEDIA_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ==========================================
# TELEGRAM NOTIFICATIONS (OPCIONAL)
# ==========================================
# Para recibir la URL del tunnel por Telegram al iniciar
# Crea tu bot con @BotFather y obtén el token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Obtén tu chat_id enviando un mensaje a @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# DOCKER (OPCIONAL)
# ==========================================
# Si ejecutas con docker/compose.yml, puedes copiar estas variables a docker/.env
ENV=production
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

POSTGRES_HOST_AUTH_METHOD=trust

CHOKIDAR_USEPOLLING=true
VITE_HMR_TIMEOUT=30000
VITE_HMR_OVERLAY=false
VITE_HMR_CLIENT_PORT=443

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
