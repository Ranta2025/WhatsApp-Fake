# ══════════════════════════════════════════════════════════════════════
#  Configuración del backend
#
#  Con Docker (`docker compose up -d --build`) NO necesitas este archivo:
#  compose.yaml ya trae valores por defecto para uso local. Copia este archivo
#  a `.env` solo para cambiar algo (puertos, correo real, llamadas…).
#
#  Sin Docker (`go run .`), el backend lee `.env` de la raíz: descomenta y
#  ajusta los valores de host (localhost) en lugar de los nombres de servicio.
# ══════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────
# ENV=production           # production: logs JSON y cookies Secure
# COOKIE_SECURE=false      # fuerza el flag Secure de las cookies (false para http://)
# SECRETKEY=cambia-esto-por-una-clave-aleatoria-de-32-caracteres-o-mas   # openssl rand -base64 48
# SEED_DEMO_DATA=true      # crea ana_demo / luis_demo / marta_demo (contraseña Demo1234!)
# SERVER_ADDR=0.0.0.0:8080

# ── Puertos publicados por Docker ─────────────────────────────────────
# WEB_PORT=80              # app (nginx)
# API_PORT=8080            # backend directo (para `npm run dev`)
# MAILPIT_UI_PORT=8025     # bandeja de correo local
# POSTGRES_PUBLIC_PORT=5432
# REDIS_PUBLIC_PORT=6379
# MINIO_PUBLIC_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ── PostgreSQL ────────────────────────────────────────────────────────
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=whatsapp
# POSTGRES_PASSWORD=whatsapp
# POSTGRES_DB=whatsapp
# POSTGRES_SSLMODE=disable
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # tiene prioridad (Neon, Render…)

# ── Redis ─────────────────────────────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=rediss://default:pass@host:6379                    # tiene prioridad (Upstash, Render…)

# ── Archivos (MinIO / S3) ─────────────────────────────────────────────
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=media
# MINIO_USE_SSL=false
# MINIO_REGION=auto               # Cloudflare R2
# MINIO_MANAGE_BUCKET=false       # R2: el bucket y su acceso público se crean en el panel
# MEDIA_PUBLIC_BASE_URL=          # URL pública del bucket (R2); vacío = /storage/...

# ── Correo (códigos de activación / recuperación) ─────────────────────
# Por defecto en Docker los correos llegan a Mailpit: http://localhost:8025
# Gmail real:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# GMAIL_FROM=tu-email@gmail.com
# GMAIL_PASSWORD=contraseña-de-aplicación
# O la API HTTP de Brevo (tiene prioridad sobre SMTP):
# BREVO_API_KEY=
# EMAIL_FROM=

# ── Red / seguridad ───────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=           # orígenes extra, separados por comas (p. ej. http://192.168.1.50)
# TRUSTED_PROXIES=                # CIDRs de proxies de confianza (por defecto redes privadas)
# CLIENT_IP_HEADER=               # p. ej. X-Real-IP detrás de Vercel

# ── Llamadas (ZegoCloud) ──────────────────────────────────────────────
# ZEGO_APP_ID=
# ZEGO_SERVER_SECRET=

# ── Notificaciones push (Web Push / VAPID) ───────────────────────────
# Sin las tres variables la funcionalidad queda deshabilitada (sin UI de push).
# Genera un par con `make vapid-keys`. Nunca subas estas claves al repo.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com   # mailto: o URL https
# PUSH_PREVIEW=off                         # off = cuerpo genérico para todos ("Nuevo mensaje")

# ── Reportes de bugs → issues de GitHub (opcional) ────────────────────
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=

# ── Telegram (script scripts/send-url-telegram.ps1, opcional) ─────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
