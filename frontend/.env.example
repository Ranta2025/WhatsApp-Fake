# URL del Backend
# Para desarrollo local, déjalo vacío o comenta la línea
# El frontend usará automáticamente window.location.hostname:8080
# VITE_BACKEND_URL=

# Para usar con ngrok, después de obtener la URL del backend:
# 1. Corre: docker-compose up -d
# 2. Ve a http://localhost:4040 y copia la URL del BACKEND
# 3. Descomenta y configura la URL aquí (sin la barra final):
# VITE_BACKEND_URL=https://tu-backend-url.ngrok-free.app

# URL de la API (usada por el sistema de bug reports)
# En desarrollo local (por defecto):
VITE_API_URL=http://localhost:8080

# En producción, configura la URL de tu backend:
# VITE_API_URL=https://tu-servidor-backend.com

