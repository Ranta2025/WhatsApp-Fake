# ──────────────────────────────────────────────────────────────
# Variables del frontend (Vite). Todas son opcionales.
# ──────────────────────────────────────────────────────────────

# URL base de la API.
#  - Vacío en desarrollo  → http(s)://<mismo host>:8080
#  - Vacío en producción  → mismo origen (nginx o las rewrites de Vercel reenvían /api)
# VITE_API_URL=http://localhost:8080

# URL base del WebSocket del backend. Necesaria cuando el frontend está en
# un dominio que no puede reenviar WebSockets (Vercel):
# VITE_WS_URL=wss://whatsapp-fake-api.onrender.com
